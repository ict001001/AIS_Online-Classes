<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Al-Rowad Online Classroom</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f6f5;--card:#fff;--ink:#12302b;--mute:#5d6f6b;--line:#d5dedb;--acc:#0b6b5c;--acc-ink:#fff;--soft:#e2f1ed;--warn:#b42318;--girls:#8a3f7a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1917;--card:#162723;--card:#162622;--ink:#e6f2ef;--mute:#9bb0ab;--line:#2b403b;--acc:#3fc3a8;--acc-ink:#05211c;--soft:#1b3a34;--warn:#ff8a7a;--girls:#d994c9}}
:root[data-theme="dark"]{--bg:#0e1917;--card:#162622;--ink:#e6f2ef;--mute:#9bb0ab;--line:#2b403b;--acc:#3fc3a8;--acc-ink:#05211c;--soft:#1b3a34;--warn:#ff8a7a;--girls:#d994c9}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 Figtree,system-ui,-apple-system,"Segoe UI",Tahoma,sans-serif}
main{max-width:860px;margin:0 auto;padding:28px 18px 60px}
h1{font-size:clamp(28px,6vw,44px);line-height:1.08;font-weight:800;margin:0 0 8px;letter-spacing:-.02em}
.brand{background:#fff;border-radius:14px;padding:12px 18px;margin-bottom:22px;display:inline-block;max-width:100%}
.brand img{display:block;height:auto;max-width:100%;width:min(340px,100%)}
.sub{color:var(--mute);margin:0 0 24px;max-width:56ch}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:0;border:2px solid var(--ink);border-radius:14px;overflow:hidden;margin-bottom:18px}
.tabs button{all:unset;cursor:pointer;text-align:left;padding:14px 18px;font-weight:600}
.tabs button b{display:block;font-size:18px;font-weight:800}
.tabs button span{font-size:13px;color:var(--mute)}
.tabs button[aria-selected=true]{background:var(--ink);color:var(--bg)}
.tabs button[aria-selected=true] span{color:inherit;opacity:.8}
.tabs button:focus-visible,.btn:focus-visible,input:focus-visible,select:focus-visible,.cls:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px}
label{display:block;font-weight:600;margin-bottom:6px}
input[type=text],input[type=email]{width:100%;font:inherit;padding:13px 14px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.btn{font:inherit;font-weight:800;border:0;border-radius:10px;padding:13px 20px;cursor:pointer;background:var(--acc);color:var(--acc-ink)}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn:disabled{opacity:.45;cursor:not-allowed}
.err{color:var(--warn);font-weight:600;margin:10px 0 0;min-height:1.4em}
.hint{color:var(--mute);font-size:14px;margin:12px 0 0}
.found{background:var(--soft);border-radius:12px;padding:16px;margin-top:16px}
.found h2{margin:0 0 2px;font-size:22px}
.found p{margin:0 0 12px;color:var(--mute)}
.seg{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 16px}
.seg button{font:inherit;font-weight:600;padding:9px 14px;border-radius:999px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.seg button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px;margin:6px 0 16px}
.cls{font:inherit;font-weight:700;padding:12px 6px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);cursor:pointer;text-align:center}
.cls small{display:block;font-weight:400;color:var(--mute);font-size:12px}
.cls[aria-pressed=true]{border-color:var(--acc);background:var(--soft);box-shadow:inset 0 0 0 1.5px var(--acc)}
.who{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.who span{font-weight:600}
[hidden]{display:none!important}
@media (max-width:520px){</style>
</head>
<body>
<main>
<header class="brand"><img src="data:image/webp;base64," alt="Al-Rowad International Schools" width="400" height="75"></header>
<h1>Online Classroom</h1>
<p class="sub">Every class has one Google Meet room. Find yours and join.</p>

<div class="tabs" role="tablist">
  <button role="tab" id="t-s" aria-selected="true" aria-controls="p-s"><b>Student</b><span>Join as guest</span></button>
  <button role="tab" id="t-t" aria-selected="false" aria-controls="p-t"><b>Teacher</b><span>Sign in with school email</span></button>
</div>

<section class="panel" id="p-s" role="tabpanel" aria-labelledby="t-s">
  <label for="adm">Admission number</label>
  <input type="text" id="adm" placeholder="S140026" autocomplete="off" autocapitalize="characters" spellcheck="false">
  <div class="row"><button class="btn" id="find">Find my class</button></div>
  <p class="err" id="s-err" role="alert"></p>
  <div class="found" id="found" hidden>
    <h2 id="f-name"></h2>
    <p id="f-class"></p>
    <button class="btn" id="join-s">Join class as guest</button>
  </div>
  <p class="hint">Enter your name in Meet exactly as shown above. The teacher will admit you.</p>
</section>

<section class="panel" id="p-t" role="tabpanel" aria-labelledby="t-t" hidden>
  <div id="t-login">
    <label for="mail">School email</label>
    <input type="email" id="mail" placeholder="name@ais.sch.sa" autocomplete="email" spellcheck="false">
    <div class="row"><button class="btn" id="signin">Continue</button></div>
    <p class="hint">Use the same school account you are signed in with in Google. Co-host access is checked by Google, not by this box.</p>
    <p class="err" id="t-err" role="alert"></p>
  </div>
  <div id="t-pick" hidden>
    <div class="who"><span id="who"></span><button class="btn ghost" id="signout">Switch account</button></div>
    <label>Section</label>
    <div class="seg" id="side"></div>
    <label>Grade</label>
    <div class="seg" id="grade"></div>
    <label>Class</label>
    <div class="grid" id="classes"></div>
    <div class="row">
      <button class="btn" id="join-t" disabled>Join class</button>
      <button class="btn ghost" id="copy" disabled>Copy link</button>
    </div>
    <p class="hint" id="t-note">Choose a class first. Joining adds you as co-host automatically, so you can admit and remove students.</p>
  </div>
</section>
</main>

