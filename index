const store={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}},del(k){try{localStorage.removeItem(k)}catch(e){}}};


// tabs
function tab(t){const s=t==="s";$("#t-s").setAttribute("aria-selected",s);$("#t-t").setAttribute("aria-selected",!s);$("#p-s").hidden=!s;$("#p-t").hidden=s}
$("#t-s").onclick=()=>tab("s");$("#t-t").onclick=()=>tab("t");

// ---------- student ----------
let found=null;
async function find(){
  const adm=$("#adm").value.trim().toUpperCase().replace(/\s+/g,"");
  $("#s-err").textContent="";$("#found").hidden=true;found=null;
  if(!adm){$("#s-err").textContent="Enter your admission number.";return}
  const rec=ROSTER[hex(await sha("id:"+adm)).slice(0,20)];
  if(!rec){$("#s-err").textContent="No student found with that number. Check it and try again, or ask the school office.";return}
  try{
    const key=await crypto.subtle.importKey("raw",await sha("key:"+adm),"AES-GCM",false,["decrypt"]);
    const raw=b64(rec);
    const [name,ci]=dec.decode(await crypto.subtle.decrypt({name:"AES-GCM",iv:raw.slice(0,12)},key,raw.slice(12))).split("|");
    found={name,ci:+ci};
    $("#f-name").textContent=name;
    if(found.ci<0||!CLASSES[found.ci]){found=null;$("#s-err").textContent="Your class room is not ready yet. Please ask the school office.";return}
    $("#f-class").textContent="Class "+CLASSES[found.ci][0];$("#found").hidden=false;
  }catch(e){$("#s-err").textContent="Could not read this record. Ask the school office."}
}
$("#find").onclick=find;
$("#adm").addEventListener("keydown",e=>{if(e.key==="Enter")find()});
$("#join-s").onclick=()=>{if(found)location.href=link(found.ci)};

// ---------- teacher ----------
let email=store.get("ais_teacher"),side="Boys",grade=null,sel=null;
const gradeKey=g=>isNaN(g)?({KG1:-3,KG2:-2,KG3:-1}[g]??0):+g;
const parse=id=>{const [s,g,c]=id.split("-");return{s,g,c}};
function showLogin(){$("#t-login").hidden=false;$("#t-pick").hidden=true}
function showPick(){
  $("#t-login").hidden=true;$("#t-pick").hidden=false;$("#who").textContent="Signed in as "+email;
  renderSide();
}
function renderSide(){
  $("#side").innerHTML="";
  ["Boys","Girls"].forEach(s=>{const b=document.createElement("button");b.textContent=s;b.setAttribute("aria-pressed",s===side);b.onclick=()=>{side=s;grade=null;sel=null;renderSide()};$("#side").append(b)});
  const gs=[...new Set(CLASSES.map(c=>parse(c[0])).filter(x=>x.s===side).map(x=>x.g))].sort((a,b)=>gradeKey(a)-gradeKey(b));
  if(!gs.includes(grade))grade=gs[0];
  $("#grade").innerHTML="";
  gs.forEach(g=>{const b=document.createElement("button");b.textContent=isNaN(g)?g:"Grade "+g;b.setAttribute("aria-pressed",g===grade);b.onclick=()=>{grade=g;sel=null;renderSide()};$("#grade").append(b)});
  $("#classes").innerHTML="";
  CLASSES.forEach((c,i)=>{const p=parse(c[0]);if(p.s!==side||p.g!==grade)return;
    const b=document.createElement("button");b.className="cls";b.setAttribute("aria-pressed",i===sel);
    b.textContent=p.g+"-"+p.c;b.onclick=()=>{sel=i;renderSide()};$("#classes").append(b)});
  $("#join-t").disabled=$("#copy").disabled=sel===null;
  $("#t-note").textContent=sel===null?"Choose a class first. Joining adds you as co-host automatically, so you can admit and remove students.":"Selected: "+CLASSES[sel][0]+" — you will join as co-host.";
}
function signin(){
  const v=$("#mail").value.trim().toLowerCase();
  if(!/^[a-z0-9._%+-]+@ais\.sch\.sa$/.test(v)){$("#t-err").textContent="Use your school email ending in "+DOMAIN;return}
  email=v;store.set("ais_teacher",v);$("#t-err").textContent="";showPick();
}
$("#signin").onclick=signin;
$("#mail").addEventListener("keydown",e=>{if(e.key==="Enter")signin()});
$("#signout").onclick=()=>{store.del("ais_teacher");email=null;sel=null;$("#mail").value="";showLogin()};
// Teachers always go through the school gateway (Apps Script), which adds the signed-in
// @ais.sch.sa account to the room as CO-HOST and then forwards to Meet.
// A plain Meet link can never make someone host, so there is no direct-link fallback.
const gw=()=>GATEWAY+(GATEWAY.includes("?")?"&":"?")+"room="+encodeURIComponent(CLASSES[sel][1])+"&authuser="+encodeURIComponent(email);
function needGateway(){
  if(GATEWAY)return false;
  $("#t-note").textContent="Teacher gateway is not configured. Ask the IT administrator to set the GATEWAY address.";
  return true;
}
$("#join-t").onclick=()=>{
  if(sel===null||needGateway())return;
  $("#t-note").textContent="Opening "+CLASSES[sel][0]+"… you will be added as co-host automatically. If a Google sign-in appears, use "+email+".";
  window.open(gw(),"_blank","noopener");
};
$("#copy").onclick=async()=>{
  if(sel===null||needGateway())return;
  const u=gw();
  try{await navigator.clipboard.writeText(u);$("#t-note").textContent="Teacher link copied (opens "+CLASSES[sel][0]+" as co-host)"}catch(e){$("#t-note").textContent=u}
};
if(email&&email.endsWith(DOMAIN)){tab("t");showPick()}
</script>
</body>
</html>
